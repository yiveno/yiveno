# Yiveno env template — copy to .env.shared.local / .env.development.local / .env.production.local
# Values are placeholders only. Never commit real secrets. See docs/ENVIRONMENT.md

# --- Shared (.env.shared.local) ---
SUPABASE_URL=<replace-me>
SUPABASE_ANON_KEY=<replace-me>
SUPABASE_SERVICE_ROLE_KEY=<replace-me>
PUBLIC_TURNSTILE_SITE_KEY=<replace-me>
TURNSTILE_SECRET_KEY=<replace-me>
