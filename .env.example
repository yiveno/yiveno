EVAL_MINT_TOKEN=<replace-me>
DODO_PAYMENTS_API_KEY=<replace-me>
DODO_PAYMENTS_WEBHOOK_KEY=<replace-me>
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_PRO_MONTHLY=<replace-me>
DODO_PRODUCT_ID_PRO_ANNUAL=<replace-me>
DODO_PRODUCT_ID_FOUNDING_MONTHLY=<replace-me>
DODO_PRODUCT_ID_FOUNDING_ANNUAL=<replace-me>
BILLING_FOUNDING_ENABLED=false
DEEPSEEK_API_KEY=<replace-me>
OPENAI_API_KEY=<replace-me>
GOOGLE_AI_API_KEY=<replace-me>
GROQ_API_KEY=<replace-me>
AI_HOSTED_QUOTA_EXEMPT_USER_IDS=<replace-me>
ALIYUN_DM_ACCESS_KEY_ID=<replace-me>
ALIYUN_DM_ACCESS_KEY_SECRET=<replace-me>
ALIYUN_DM_ACCOUNT_NAME=<replace-me>
ALIYUN_DM_FROM_ALIAS=<replace-me>
ALIYUN_DM_REPLY_ADDRESS=<replace-me>
ALIYUN_DM_REGION_ID=<replace-me>
ALIYUN_DM_ENDPOINT=<replace-me>

# --- Development overrides (.env.development.local) ---
WEBSITE_URL=http://localhost:3001
VITE_WEBSITE_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:8787
VITE_CLOUDFLARE_WORKER_URL=http://localhost:8787

