{
  "enabled": true,
  "name": "Website Quality Check",
  "description": "修改 website 文件后自动运行 typecheck 检查",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["website/**/*.ts", "website/**/*.vue", "website/**/*.js"]
  },
  "then": {
    "type": "runCommand",
    "command": "cd website && bun run typecheck",
    "timeout": 60
  }
}
