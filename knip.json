{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignore": ["**/*.d.ts", "frontend/src/tests/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["puppeteer-core"],
  "ignoreBinaries": ["wait"],
  "tags": ["-lintignore"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "duplicates": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error"
  },
  "ignoreIssues": {
    "frontend/src/types/**": ["types", "exports"],
    "frontend/src/stores/index.ts": ["types", "exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,ts}"]
    },
    "frontend": {
      "entry": [
        "src/pages/*/main.ts",
        "src/background/main.ts",
        "src/offscreen/main.ts",
        "src/core/common/result.ts",
        "src/infrastructure/events/event-bus.ts",
        "src/infrastructure/indexeddb/manager.ts",
        "src/infrastructure/offscreen/manager.ts",
        "vite/build-options.ts",
        "scripts/**/*.{js,ts,cjs}"
      ],
      "project": ["src/**/*.{ts,vue}", "vite/**/*.ts", "scripts/**/*.{js,ts,cjs}"]
    },
    "backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "website": {
      "entry": ["src/pages/**/*.astro", "src/**/*.vue"],
      "project": ["src/**/*.{astro,vue,ts}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
