{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignore": ["**/*.d.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["puppeteer-core"],
  "ignoreBinaries": ["run", "mprocs"],
  "tags": ["-lintignore"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "duplicates": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error"
  },
  "ignoreIssues": {
    "backend/src/trpc-router.ts": ["types", "exports"],
    "frontend/src/background/commands/registry.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,mjs,ts}"],
      "project": ["scripts/**/*.{js,mjs,ts}"]
    },
    "frontend": {
      "entry": [
        "src/pages/*/main.ts",
        "src/dev/probe-console/main.ts",
        "src/dev/probe/debug-dev-handler.ts",
        "src/dev/probe/debug-dev-handler.prod-stub.ts",
        "src/dev/probe/expose-recall-probe-seed-debug.ts",
        "src/dev/probe/expose-recall-probe-seed-debug.prod-stub.ts",
        "src/infrastructure/debug/expose-clue-gateway-debug.prod-stub.ts",
        "src/infrastructure/debug/expose-memory-dev-debug.prod-stub.ts",
        "src/infrastructure/debug/expose-recall-telemetry-debug.prod-stub.ts",
        "src/background/main.ts",
        "src/content/**/main.ts",
        "src/offscreen/main.ts",
        "vite/build-options.ts",
        "scripts/**/*.{js,ts,cjs}"
      ],
      "project": ["src/**/*.{ts,vue}", "vite/**/*.ts", "scripts/**/*.{js,ts,cjs}"]
    },
    "packages/yiveno-probe": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,vue}"]
    },
    "backend": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "website": {
      "entry": ["src/pages/**/*.astro", "src/**/*.vue", "src/**/*.test.ts"],
      "project": ["src/**/*.{astro,vue,ts}"]
    }
  }
}
