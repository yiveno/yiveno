{
  // Vitest 单测 TypeScript 配置（仅测试文件，不重复整棵 src）
  // 生产源码由 tsconfig.app 经 vue-tsc -b 覆盖；本工程只检 *.test/spec
  // 接入：挂在 extension/tsconfig.json references（IDE + vue-tsc -b）；
  // typecheck / typecheck:vitest 仍可 -p 本文件单独跑
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["chrome", "node", "vitest/globals"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/tests/**/*",
    "**/__tests__/**/*"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
