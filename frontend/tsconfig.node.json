{
  // Vite构建工具TypeScript配置
  // 适用范围：vite.config.ts 及其他构建脚本
  // 环境：Node.js (Bun) - 非DOM环境
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "vite/**/*.ts", "vitest.config.mts"]
}
