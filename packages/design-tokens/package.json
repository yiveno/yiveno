{
  "name": "@yiveno/design-tokens",
  "version": "1.4.0",
  "description": "Yiveno design tokens — Brand Core, Product Roles, spacing/radius. MD multi-presets removed.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./brand": {
      "types": "./src/brand.ts",
      "import": "./src/brand.ts",
      "require": "./src/brand.ts",
      "default": "./src/brand.ts"
    },
    "./colors": {
      "types": "./src/colors.ts",
      "import": "./src/colors.ts",
      "require": "./src/colors.ts",
      "default": "./src/colors.ts"
    },
    "./color-presets": {
      "types": "./src/color-presets.ts",
      "import": "./src/color-presets.ts",
      "require": "./src/color-presets.ts",
      "default": "./src/color-presets.ts"
    },
    "./spacing": {
      "types": "./src/spacing.ts",
      "import": "./src/spacing.ts",
      "require": "./src/spacing.ts",
      "default": "./src/spacing.ts"
    },
    "./typography": {
      "types": "./src/typography.ts",
      "import": "./src/typography.ts",
      "require": "./src/typography.ts",
      "default": "./src/typography.ts"
    },
    "./animations": {
      "types": "./src/animations.ts",
      "import": "./src/animations.ts",
      "require": "./src/animations.ts",
      "default": "./src/animations.ts"
    },
    "./effects": {
      "types": "./src/effects.ts",
      "import": "./src/effects.ts",
      "require": "./src/effects.ts",
      "default": "./src/effects.ts"
    },
    "./css-vars": {
      "types": "./src/css-vars.ts",
      "import": "./src/css-vars.ts",
      "require": "./src/css-vars.ts",
      "default": "./src/css-vars.ts"
    },
    "./css/brand.css": {
      "import": "./css/brand.css",
      "require": "./css/brand.css",
      "default": "./css/brand.css"
    },
    "./css/md-sys-brand-alias.css": {
      "import": "./css/md-sys-brand-alias.css",
      "require": "./css/md-sys-brand-alias.css",
      "default": "./css/md-sys-brand-alias.css"
    },
    "./css/variables.css": {
      "import": "./css/variables.css",
      "require": "./css/variables.css",
      "default": "./css/variables.css"
    },
    "./css/semantic-colors.css": {
      "import": "./css/semantic-colors.css",
      "require": "./css/semantic-colors.css",
      "default": "./css/semantic-colors.css"
    }
  },
  "files": [
    "src",
    "css",
    "docs",
    "examples",
    "README.md",
    "USAGE.md"
  ],
  "keywords": [
    "design-tokens",
    "design-system",
    "theme",
    "brand",
    "css-variables",
    "typescript",
    "yiveno",
    "ui",
    "colors"
  ],
  "author": "Yiveno Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yiveno/yiveno.git",
    "directory": "packages/design-tokens"
  },
  "bugs": {
    "url": "https://github.com/yiveno/yiveno/issues"
  },
  "homepage": "https://github.com/yiveno/yiveno/tree/main/packages/design-tokens#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:force": "tsc --noEmit"
  }
}
