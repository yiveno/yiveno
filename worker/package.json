{
  "name": "worker",
  "version": "1.0.0",
  "description": "Yiveno Cloudflare Worker API",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun ../scripts/dev-env.mjs sync --profile=development --target=worker --quiet && NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem wrangler dev --port 8787",
    "build": "echo 'Worker: Cloudflare Worker 无需构建'",
    "typecheck": "tsc --noEmit",
    "typecheck:force": "tsc --noEmit",
    "types:gen": "wrangler types --strict-vars=false",
    "lint": "bun run format && bun run eslint",
    "lint:check": "bun run eslint:check",
    "format": "bunx prettier --write \"**/*.{js,ts,json}\"",
    "eslint": "eslint . --no-cache --fix --max-warnings 0 --fix-type problem,suggestion,layout && echo '✅ ESLint: 所有问题已修复'",
    "eslint:check": "eslint . --no-cache --max-warnings 0 && echo '✅ ESLint: 检查通过'",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "logs": "wrangler tail",
    "clean": "rm -rf .wrangler node_modules/.cache"
  },
  "dependencies": {
    "@yiveno/types": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.1",
    "supabase": "^2.120.0"
  },
  "runtime": "bun",
  "keywords": [
    "cloudflare-worker",
    "bookmark",
    "chrome-extension",
    "high-performance"
  ]
}
