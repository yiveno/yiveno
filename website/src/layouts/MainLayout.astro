---
import Nav from '../components/Nav.astro'
import '../styles/site.css'

interface Props {
  /** 页面标题（写入 document title） */
  title?: string
  /** meta description */
  description?: string
  /** home：深墨门面；默认浅纸面 */
  chrome?: 'default' | 'home'
}

const {
  title = 'Yiveno',
  description = 'Find the stuff you saved. Say what you remember — Yiveno brings back the closest matches.',
  chrome = 'default'
} = Astro.props

const canonicalOrigin = 'https://yiveno.com'
const ogImage = `${canonicalOrigin}/og-image.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1C2A24" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
    />
  </head>
  <body data-chrome={chrome}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="/support">Support</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <span>© 2026 Yiveno</span>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Atkinson Hyperlegible', ui-sans-serif, system-ui, sans-serif;
  }

  h1,
  h2,
  h3,
  .site-nav__name {
    font-family: 'Archivo', ui-sans-serif, system-ui, sans-serif;
  }
</style>
