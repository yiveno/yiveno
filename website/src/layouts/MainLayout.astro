---
import Nav from '../components/Nav.astro'

interface Props {
  /** 页面标题（写入 document title） */
  title?: string
  /** meta description */
  description?: string
}

const {
  title = 'Yiveno',
  description = 'Yiveno helps you capture and recall personal browsing traces—excerpts and notes—not another bookmark manager.'
} = Astro.props

const canonicalOrigin = 'https://yiveno.com'
const ogImage = `${canonicalOrigin}/og-image.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1E2640" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer style="text-align:center;padding:2rem;color:#666;font-size:0.875rem;">
      <p>
        <a href="/privacy" style="color:#555;margin-right:1rem;">Privacy</a>
        <a href="/terms" style="color:#555;margin-right:1rem;">Terms</a>
        <span>© 2026 Yiveno. All rights reserved.</span>
      </p>
    </footer>
  </body>
</html>
