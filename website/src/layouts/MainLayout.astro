---
import YMark from '../components/home/YMark.astro'
import MarketingNav from '../components/MarketingNav.astro'
import WebsiteLanguageSwitcher from '../components/WebsiteLanguageSwitcher.vue'
import fontsCriticalCssRaw from '../../public/fonts/fonts-critical.css?raw'
/** Brand Core + Roles；?raw 不会解析 CSS @import，须与 site-critical 显式拼接 */
import brandCssRaw from '@yiveno/design-tokens/css/brand.css?raw'
import siteCriticalCssRaw from '../styles/site-critical.css?raw'
import siteDeferredHref from '../styles/site-deferred.css?url'
import homeCriticalCssRaw from '../styles/home-critical.css?raw'
import { minifyCss } from '../lib/minify-css'

interface Props {
  /** 页面标题（写入 document title） */
  title?: string
  /** meta description */
  description?: string
  /** home：深色 Hero 上门面配色；链接与内页相同 */
  chrome?: 'default' | 'home'
  /** 账号/结账等非公开页：禁止索引 */
  noindex?: boolean
  /** 首页等：输出 SoftwareApplication JSON-LD（GEO） */
  jsonLd?: boolean
}

const {
  title = 'Yiveno',
  description = 'Find the stuff you saved. Say what you remember — Yiveno brings back the closest fits.',
  chrome = 'default',
  noindex = false,
  jsonLd = false
} = Astro.props

const waitlistNav = chrome === 'home'
const canonicalOrigin = 'https://yiveno.com'
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonicalUrl = `${canonicalOrigin}${pathname === '/' ? '/' : pathname}`
const ogImage = `${canonicalOrigin}/og-image.jpg`

/** 仅内联首屏所需 CSS；site/home deferred 异步加载（可长缓存） */
const fontsCriticalCss = minifyCss(fontsCriticalCssRaw)
const siteCriticalCss = minifyCss(`${brandCssRaw}\n${siteCriticalCssRaw}`)
const homeCriticalCss = chrome === 'home' ? minifyCss(homeCriticalCssRaw) : ''

/** GEO：可引用的产品实体定义（与产品文档 §0.1 对外心智对齐；预约阶段无在售 Offer） */
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Yiveno',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  url: canonicalOrigin,
  description:
    'Find what you saved from what you remember. Closest matches from your captures — you pick. Chrome extension in active development.',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/PreOrder',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Chrome extension in active development; Free/Pro details at launch.'
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      ;(function () {
        try {
          var pref = localStorage.getItem('yiveno.website.uiLocale') || 'system'
          var nav = (navigator.language || 'en').toLowerCase().replace(/_/g, '-')
          var zh = nav === 'zh' || nav.indexOf('zh-') === 0
          var locale = pref === 'zh_CN' || pref === 'en' ? pref : zh ? 'zh_CN' : 'en'
          document.documentElement.lang = locale === 'zh_CN' ? 'zh-CN' : 'en'
          document.documentElement.dataset.yivenoUiLocale = locale
        } catch (e) {}
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#192420" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yiveno" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />}
    <link
      rel="preload"
      href="/fonts/fraunces-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/worksans-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style set:html={fontsCriticalCss} />
    <style set:html={siteCriticalCss} />
    {homeCriticalCss && <style set:html={homeCriticalCss} />}
    <link
      rel="preload"
      href={siteDeferredHref}
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={siteDeferredHref} />
    </noscript>
    <link
      rel="preload"
      href="/fonts/fonts-rest.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="/fonts/fonts-rest.css" />
    </noscript>
    <slot name="head" />
  </head>
  <body data-chrome={chrome} data-nav-over-hero={waitlistNav ? 'true' : undefined}>
    <a class="skip-link" href="#main" data-yiveno-i18n="a11y.skip_to_content">
      Skip to content
    </a>
    {/* 默认营销 Nav；账号域页面用 slot="nav" 注入 AppNav，避免首页打进 AuthNav CSS */}
    <slot name="nav">
      <MarketingNav waitlist={waitlistNav} />
    </slot>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="site-footer__brand" href="/">
        <YMark class="site-footer__logo" size={22} />
        <span class="site-footer__name">Yiveno</span>
        <span class="site-footer__meta">· © 2026</span>
        <span class="site-footer__meta" data-yiveno-i18n="footer.tagline">
          · Find what you saved.
        </span>
      </a>
      <div class="site-footer__end">
        <ul class="site-footer__links">
          <li>
            <a href="/support" data-yiveno-i18n="footer.support">
              Support
            </a>
          </li>
          <li>
            <a href="/privacy" data-yiveno-i18n="footer.privacy">
              Privacy
            </a>
          </li>
          <li>
            <a href="/terms" data-yiveno-i18n="footer.terms">
              Terms
            </a>
          </li>
        </ul>
        <WebsiteLanguageSwitcher client:load menu-placement="above" />
      </div>
    </footer>
    <script is:inline>
      ;(function () {
        var dict = {
          en: {
            'footer.support': 'Support',
            'footer.privacy': 'Privacy',
            'footer.terms': 'Terms',
            'footer.tagline': '· Find what you saved.',
            'a11y.skip_to_content': 'Skip to content',
            'nav.aria_primary': 'Primary'
          },
          zh_CN: {
            'footer.support': '支持',
            'footer.privacy': '隐私',
            'footer.terms': '条款',
            'footer.tagline': '· 找回你存过的。',
            'a11y.skip_to_content': '跳到正文',
            'nav.aria_primary': '主导航'
          }
        }
        var locale = document.documentElement.dataset.yivenoUiLocale || 'en'
        var pack = dict[locale] || dict.en
        document.querySelectorAll('[data-yiveno-i18n]').forEach(function (el) {
          var key = el.getAttribute('data-yiveno-i18n')
          if (key && pack[key]) el.textContent = pack[key]
        })
        var nav = document.querySelector('.site-nav')
        if (nav && pack['nav.aria_primary'])
          nav.setAttribute('aria-label', pack['nav.aria_primary'])
      })()
    </script>
  </body>
</html>
