---
import Nav from '../components/Nav.astro'
import '../styles/site.css'
import '../styles/pages.css'

interface Props {
  /** 页面标题（写入 document title） */
  title?: string
  /** meta description */
  description?: string
  /** home：深色 Hero 上门面配色；链接与内页相同 */
  chrome?: 'default' | 'home'
  /** 账号/结账等非公开页：禁止索引 */
  noindex?: boolean
  /** 首页等：输出 SoftwareApplication JSON-LD（GEO） */
  jsonLd?: boolean
}

const {
  title = 'Yiveno',
  description = 'Find the stuff you saved. Say what you remember — Yiveno brings back the closest matches.',
  chrome = 'default',
  noindex = false,
  jsonLd = false
} = Astro.props

const waitlistNav = chrome === 'home'
const canonicalOrigin = 'https://yiveno.com'
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const canonicalUrl = `${canonicalOrigin}${pathname === '/' ? '/' : pathname}`
const ogImage = `${canonicalOrigin}/og-image.png`

/** GEO：可引用的产品实体定义（与产品文档 §0.1 对外心智对齐） */
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Yiveno',
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome',
  url: canonicalOrigin,
  description:
    'Yiveno is the thing that finds what you saved. Say what you remember — it brings back the closest matches from your own captures, and you pick. Not a bookmark manager, note organizer, or chatbot.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    description: 'Free tier at launch; Pro for sync and higher quotas (details confirmed at launch).'
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow" />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#192420" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yiveno" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap"
    />
  </head>
  <body data-chrome={chrome} data-nav-over-hero={waitlistNav ? 'true' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav waitlist={waitlistNav} />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <a class="site-footer__brand" href="/">
        <img
          class="site-footer__logo"
          src="/images/logo-mark.svg"
          alt=""
          width="16"
          height="16"
          decoding="async"
        />
        <span class="site-footer__name">Yiveno</span>
        <span class="site-footer__meta">· © 2026</span>
      </a>
      <ul class="site-footer__links">
        <li><a href="/support">Support</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </footer>
  </body>
</html>
