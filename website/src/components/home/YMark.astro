---
/**
 * Make 设计稿中的抽象 Y 标（与 Figma Make App.tsx YMark 一致）。
 * 默认 currentColor，随父级文字色变化（Nav / Footer 无需双份 SVG）。
 */
interface Props {
  size?: number
  /** 固定描边色；缺省用 currentColor */
  stroke?: string
  class?: string
}

const { size = 22, stroke = 'currentColor', class: className } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 22 22"
  fill="none"
  aria-hidden="true"
>
  <circle cx="11" cy="11" r="10" stroke={stroke} stroke-opacity="0.3" stroke-width="1"></circle>
  <path
    d="M7.2 6L11 11.4L14.8 6"
    stroke={stroke}
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <line
    x1="11"
    y1="11.4"
    x2="11"
    y2="16.2"
    stroke={stroke}
    stroke-width="1.5"
    stroke-linecap="round"></line>
</svg>
