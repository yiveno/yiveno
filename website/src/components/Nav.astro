---
import AuthNav from './AuthNav.vue'
import YMark from './home/YMark.astro'

interface Props {
  /** waitlist 首页：只保留 Support，不暴露 Pricing / Sign in；标用 Make YMark */
  waitlist?: boolean
}

const { waitlist = false } = Astro.props
---

<nav class="site-nav" class:list={[{ 'site-nav--waitlist': waitlist }]} aria-label="Primary">
  <a href="/" class="site-nav__brand">
    {
      waitlist ? (
        <span class="site-nav__ymark site-nav__ymark--dark">
          <YMark size={22} onDark />
        </span>
      ) : (
        <img
          class="site-nav__logo"
          src="/images/logo-mark.svg"
          alt=""
          width="22"
          height="22"
          decoding="async"
        />
      )
    }
    {
      waitlist && (
        <span class="site-nav__ymark site-nav__ymark--light" aria-hidden="true">
          <YMark size={22} />
        </span>
      )
    }
    <span class="site-nav__name">Yiveno</span>
  </a>
  <div class="site-nav__spacer"></div>
  {
    !waitlist && (
      <a href="/pricing" class="site-nav__link">
        Pricing
      </a>
    )
  }
  <a href="/support" class="site-nav__link">Support</a>
  {!waitlist && <AuthNav client:load />}
</nav>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.8vw, 2.1rem);
    height: 60px;
    padding: 0 var(--pad-x);
    background: var(--nav-bg);
    color: var(--nav-fg);
    border-bottom: 1px solid var(--nav-line);
    transition: color 0.3s ease;
  }

  /* Make：Nav 始终透明，仅改文字色 */
  .site-nav--waitlist {
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .site-nav__logo {
    display: block;
    width: 22px;
    height: 22px;
    object-fit: contain;
    opacity: 0.85;
  }

  .site-nav__ymark {
    display: none;
    line-height: 0;
  }

  :global(body[data-chrome='home'][data-nav-over-hero='true']) .site-nav__ymark--dark {
    display: block;
  }

  :global(body[data-chrome='home'][data-nav-over-hero='false']) .site-nav__ymark--light {
    display: block;
  }

  .site-nav__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--nav-brand, inherit);
    transition: color 0.3s;
  }

  .site-nav__spacer {
    flex: 1;
  }

  .site-nav__link {
    text-decoration: none;
    color: var(--nav-muted);
    font-size: 13.5px;
    font-weight: 400;
    letter-spacing: 0.005em;
    transition: color 0.18s ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--nav-fg);
  }

  .site-nav__link:focus-visible,
  .site-nav__brand:focus-visible {
    outline: 2px solid var(--sage);
    outline-offset: 3px;
  }

  :global(body[data-chrome='home'][data-nav-over-hero='true']) .site-nav__link:focus-visible,
  :global(body[data-chrome='home'][data-nav-over-hero='true']) .site-nav__brand:focus-visible {
    outline-color: var(--sage-on);
  }
</style>
