---
import AuthNav from './AuthNav.vue'
---

<nav class="site-nav" aria-label="Primary">
  <a href="/" class="site-nav__brand">
    <img
      class="site-nav__logo"
      src="/images/logo-mark.svg"
      alt=""
      width="28"
      height="28"
      decoding="async"
    />
    <span class="site-nav__name">Yiveno</span>
  </a>
  <div class="site-nav__spacer"></div>
  <a href="/pricing" class="site-nav__link">Pricing</a>
  <a href="/support" class="site-nav__link">Support</a>
  <AuthNav client:load />
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.5rem;
    background: var(--nav-bg);
    color: var(--nav-fg);
    border-bottom: 1px solid var(--nav-line);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: inherit;
  }

  .site-nav__logo {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  :global(body[data-chrome='home']) .site-nav__logo {
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .site-nav__name {
    line-height: 1;
  }

  .site-nav__spacer {
    flex: 1;
  }

  .site-nav__link {
    text-decoration: none;
    color: var(--nav-muted);
    font-size: 0.95rem;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: var(--nav-fg);
  }

  .site-nav__link:focus-visible,
  .site-nav__brand:focus-visible {
    outline: 2px solid var(--sage);
    outline-offset: 3px;
  }

  :global(body[data-chrome='home']) .site-nav__link:focus-visible,
  :global(body[data-chrome='home']) .site-nav__brand:focus-visible {
    outline-color: var(--sage-on);
  }
</style>
