---
/**
 * 营销页 Nav：无 AuthNav 依赖；语言切换为 Vue island。
 */
import YMark from './home/YMark.astro'

interface Props {
  waitlist?: boolean
}

const { waitlist = false } = Astro.props
---

<nav class="site-nav" class:list={[{ 'site-nav--waitlist': waitlist }]} aria-label="Primary">
  <a href="/" class="site-nav__brand">
    <YMark class="site-nav__logo" size={28} adaptiveNav={waitlist} />
    <span class="site-nav__name">Yiveno</span>
  </a>
  <div class="site-nav__spacer"></div>
  {/* Pricing：上线前仍隐藏；Sign in 已开放。Support / 语言切换在页脚。 */}
  <a href="/login" class="site-nav__link" data-yiveno-i18n="nav.sign_in">
    Sign in
  </a>
</nav>
