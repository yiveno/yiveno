---
/**
 * Waitlist 报名表单（纯 Astro + 原生 script，首页不引入 Vue）。
 */
interface Props {
  /** 深色底（Hero / Final CTA）或浅色底 */
  tone?: 'dark' | 'light'
  /** 居中排版（Final CTA） */
  centered?: boolean
}

const { tone = 'dark', centered = false } = Astro.props
const apiBase = (import.meta.env.PUBLIC_API_BASE_URL || 'https://api.yiveno.com').replace(/\/$/, '')
const uid = `wl-${Math.random().toString(36).slice(2, 9)}`
---

<div
  class:list={['waitlist', `waitlist--${tone}`, { 'waitlist--centered': centered }]}
  data-waitlist
  data-api-base={apiBase}
>
  <p class="waitlist__ok" role="status" hidden data-waitlist-ok>
    You're on the list. We'll email you first when Yiveno is ready to try.
  </p>
  <div data-waitlist-form-wrap>
    <form class="waitlist__form" novalidate data-waitlist-form>
      <label class="waitlist__label" for={`${uid}-email`}>Email</label>
      <input
        id={`${uid}-email`}
        class="waitlist__input"
        type="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        required
        data-waitlist-email
      />
      <div class="waitlist__hp" aria-hidden="true">
        <label for={`${uid}-company`}>Company</label>
        <input
          id={`${uid}-company`}
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          data-waitlist-company
        />
      </div>
      <button class="waitlist__submit" type="submit" data-waitlist-submit>Notify me</button>
    </form>
    <p class="waitlist__err" role="alert" hidden data-waitlist-err></p>
    <p class="waitlist__note">
      Not available to install yet. One email when early access opens — nothing else.
      <a href="/privacy">Privacy</a>
    </p>
  </div>
</div>
