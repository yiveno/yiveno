---
/**
 * Paddle Default payment link 落地页。
 * 须含 Paddle.js；带 `_ptxn` 时自动打开对应 transaction checkout。
 */
import MainLayout from '../layouts/MainLayout.astro'

const clientToken = (import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN || '').trim()
const paddleEnvRaw = import.meta.env.PUBLIC_PADDLE_ENV
if (paddleEnvRaw !== 'sandbox' && paddleEnvRaw !== 'production') {
  throw new Error(
    '[Billing] PUBLIC_PADDLE_ENV must be set to "sandbox" or "production" (never silently defaulted)'
  )
}
const paddleEnv = paddleEnvRaw
const websiteBase = (import.meta.env.PUBLIC_WEBSITE_URL || '').replace(/\/$/, '')
const successUrl = `${websiteBase || 'http://localhost:3001'}/welcome`
---

<MainLayout
  noindex
  title="Checkout · Yiveno"
  description="Complete your Yiveno checkout."
>
  <article class="page page--narrow">
    <h1 class="page__title">Checkout</h1>
    {
      clientToken ? (
        <p class="page__lede">Opening Paddle checkout…</p>
      ) : (
        <p class="page__lede">Checkout is not configured. Please contact support.</p>
      )
    }
    <p class="page__actions">
      <a class="ui-btn ui-btn--ghost" href="/pricing">Back to pricing</a>
    </p>
  </article>
  {
    clientToken && (
      <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
    )
  }
  {
    clientToken && (
      <script is:inline define:vars={{ clientToken, paddleEnv, successUrl }}>
        const paddle = window.Paddle
        if (!paddle) {
          console.error('[Yiveno] Paddle.js failed to load')
        } else {
          if (paddleEnv === 'sandbox') {
            paddle.Environment.set('sandbox')
          }
          paddle.Initialize({
            token: clientToken,
            checkout: {
              settings: {
                displayMode: 'overlay',
                variant: 'one-page',
                successUrl
              }
            }
          })
        }
      </script>
    )
  }
</MainLayout>
