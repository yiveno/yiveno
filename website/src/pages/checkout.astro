---
/**
 * Checkout 入口已迁到 /pricing（Worker 创建 Dodo hosted session）。
 */
import MainLayout from '../layouts/MainLayout.astro'
import AppNav from '../components/AppNav.astro'
import '../styles/pages.css'
---

<MainLayout noindex title="Checkout · Yiveno" description="Start checkout from Yiveno pricing.">
  <AppNav slot="nav" />
  <article class="page page--narrow">
    <h1 class="page__title">Checkout</h1>
    <p class="page__lede">
      Subscriptions start from the pricing page after you sign in. We never open checkout without
      linking it to your Yiveno account.
    </p>
    <p class="page__actions">
      <a class="ui-btn ui-btn--primary" href="/pricing">Go to pricing</a>
    </p>
  </article>
</MainLayout>
