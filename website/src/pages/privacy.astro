---
/**
 * 官网隐私政策（与当前产品实现对齐；非律师意见书）。
 * 同 URL 双语：英文权威；中文便利译本（冲突以英文为准）。
 */
import MainLayout from '../layouts/MainLayout.astro'
import PrivacyProseEn from '../components/legal/PrivacyProseEn.astro'
import PrivacyProseZh from '../components/legal/PrivacyProseZh.astro'
import { en } from '../i18n/en'
import '../styles/pages.css'

const effectiveDate = '2026-11-01'
---

<MainLayout
  title={en['privacy.meta.title']}
  description={en['privacy.meta.description']}
  i18nTitleKey="privacy.meta.title"
>
  <article class="page">
    <header>
      <h1 class="page__title" data-yiveno-i18n="privacy.title">
        {en['privacy.title']}
      </h1>
      <p class="page__meta">
        <span data-yiveno-legal-locale="en" lang="en">
          Effective date: {effectiveDate}
        </span>
        <span data-yiveno-legal-locale="zh_CN" lang="zh-CN" hidden>
          生效日期：{effectiveDate}
        </span>
      </p>
      <p
        class="page__hint"
        data-yiveno-legal-locale="zh_CN"
        lang="zh-CN"
        hidden
        data-yiveno-i18n="privacy.translation_note"
      >
        {en['privacy.translation_note']}
      </p>
    </header>

    <PrivacyProseEn />
    <PrivacyProseZh />
  </article>
</MainLayout>
