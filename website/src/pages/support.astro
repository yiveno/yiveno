---
/**
 * 旧 `/support` 桥接 → `/faq#contact`。
 * Cloudflare Pages `_redirects` 里 `#` 会当注释，不能写 fragment；故保留本页软跳。
 * 不进 sitemap；canonical 指向 FAQ。
 */
const target = '/faq#contact'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href="https://yiveno.com/faq" />
    <title>Redirecting · Yiveno</title>
    <script is:inline>
      location.replace('/faq#contact')
    </script>
  </head>
  <body>
    <p>
      <a href={target}>Continue to FAQ · Contact</a>
    </p>
  </body>
</html>
