---
/**
 * 极简 Support / Contact：产品问题走邮箱；计费取消走 Portal；退款走 Paddle Buyer Support。
 * 不做工单系统。
 */
import MainLayout from '../layouts/MainLayout.astro'

const supportEmail = 'support@yiveno.com'
const privacyEmail = 'privacy@yiveno.com'
const paddleBuyerSupport = 'https://paddle.net'
---

<MainLayout
  title="Support · Yiveno"
  description="Get help with Yiveno: product support, billing, cancellation, and refunds."
>
  <article class="page">
    <header>
      <h1 class="page__title">Support</h1>
      <p class="page__lede">
        Yiveno is the Chrome extension that finds what you saved — closest matches from your own
        captures, you pick. Tell us what you need below. Billing cancellations and card updates are
        self-serve; refunds go through Paddle; product issues reach us by email.
      </p>
    </header>

    <section class="page__section">
      <h2>Billing &amp; subscription</h2>
      <ul>
        <li>
          <strong>Cancel, change payment method, or view invoices</strong> — sign in and open
          <a href="/account">Account</a> → <em>Manage subscription</em> (Paddle Customer Portal).
        </li>
        <li>
          <strong>Request a refund</strong> — Paddle is the merchant of record. Use
          <a href={paddleBuyerSupport} target="_blank" rel="noopener noreferrer">Paddle Buyer Support</a>
          or the receipt email from your purchase. Canceling a subscription stops future renewals; it
          does not automatically refund the current period.
        </li>
      </ul>
    </section>

    <section class="page__section">
      <h2>Product &amp; account</h2>
      <p>
        Extension, sync, sign-in, or other product questions:
        <a href={`mailto:${supportEmail}?subject=Yiveno%20support`}>{supportEmail}</a>
      </p>
      <p class="page__hint">
        Include your account email and a short description. We do not run a ticket portal yet — email
        is enough.
      </p>
    </section>

    <section class="page__section">
      <h2>Privacy</h2>
      <p>
        Privacy questions:
        <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>
        ·
        <a href="/privacy">Privacy Policy</a>
      </p>
    </section>

    <section class="page__section">
      <h2>Complaints</h2>
      <p>
        If something went wrong and you want it escalated, email
        <a href={`mailto:${supportEmail}?subject=Yiveno%20complaint`}>{supportEmail}</a>
        with the subject line "Complaint", your account email, and what happened. For payment disputes
        you may also contact Paddle directly.
      </p>
    </section>
  </article>
</MainLayout>
