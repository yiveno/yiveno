---
/**
 * 预约阶段 Support：产品未公开发售；邮箱为主，不引导计费/账号自助。
 * 不做工单系统。
 */
import MainLayout from '../layouts/MainLayout.astro'
import '../styles/pages.css'

const supportEmail = 'support@yiveno.com'
const privacyEmail = 'privacy@yiveno.com'
---

<MainLayout
  title="Support · Yiveno"
  description="Yiveno is in active development. Questions about the waitlist or the product — email us."
>
  <article class="page">
    <header>
      <h1 class="page__title">Support</h1>
      <p class="page__lede">
        Yiveno is the Chrome extension that finds what you saved — closest fits from your own
        captures, you pick. The product isn't publicly available yet; we're building it and taking
        waitlist signups. Questions below go to email.
      </p>
    </header>

    <section class="page__section">
      <h2>Waitlist</h2>
      <p>
        Joined the list on the homepage and need to change or remove your email? Write
        <a href={`mailto:${supportEmail}?subject=Yiveno%20waitlist`}>{supportEmail}</a>
        with the subject "Waitlist".
      </p>
    </section>

    <section class="page__section">
      <h2>Product</h2>
      <p>
        Questions about what Yiveno is (or isn't), privacy, or the roadmap:
        <a href={`mailto:${supportEmail}?subject=Yiveno%20support`}>{supportEmail}</a>
      </p>
      <p class="page__hint">Email works best — include a bit of context so we can reply once.</p>
    </section>

    <section class="page__section">
      <h2>Privacy</h2>
      <p>
        Privacy questions:
        <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>·<a href="/privacy">Privacy Policy</a>
      </p>
    </section>
  </article>
</MainLayout>
