---
/**
 * Support：要回复的问题走 support@（轨道 3 · 轻量工单 = 邮件线程）。
 * 产品意见走 feedback@；不做自建工单系统。
 */
import MainLayout from '../layouts/MainLayout.astro'
import '../styles/pages.css'

const supportEmail = 'support@yiveno.com'
const feedbackEmail = 'feedback@yiveno.com'
const privacyEmail = 'privacy@yiveno.com'
---

<MainLayout
  title="Support · Yiveno"
  description="Get help with Yiveno — bugs, account, and waitlist questions by email. We reply at support@yiveno.com."
>
  <article class="page">
    <header>
      <h1 class="page__title">Support</h1>
      <p class="page__lede">
        Need a reply? Email us. For product ideas that don’t need a reply, use
        <a href={`mailto:${feedbackEmail}`}>{feedbackEmail}</a>
        or the optional form if you remove the extension.
      </p>
    </header>

    <section class="page__section">
      <h2>Bugs &amp; account help</h2>
      <p>
        Something broken, can’t sign in, sync issues, or billing questions:
        <a href={`mailto:${supportEmail}?subject=Yiveno%20support`}>{supportEmail}</a>
      </p>
      <p class="page__hint">
        Include what you tried, your Chrome version, and the extension version if you can — one
        clear note helps us reply once.
      </p>
    </section>

    <section class="page__section">
      <h2>Waitlist</h2>
      <p>
        Joined the list on the homepage and need to change or remove your email? Write
        <a href={`mailto:${supportEmail}?subject=Yiveno%20waitlist`}>{supportEmail}</a>
        with the subject "Waitlist".
      </p>
    </section>

    <section class="page__section">
      <h2>Product ideas</h2>
      <p>
        Feature ideas or “why I left” style notes (no reply expected):
        <a href={`mailto:${feedbackEmail}?subject=Yiveno%20feedback`}>{feedbackEmail}</a>
      </p>
    </section>

    <section class="page__section">
      <h2>Privacy</h2>
      <p>
        Privacy questions:
        <a href={`mailto:${privacyEmail}`}>{privacyEmail}</a>·<a href="/privacy">Privacy Policy</a>
      </p>
    </section>
  </article>
</MainLayout>
