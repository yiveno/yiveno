---
import MainLayout from '../layouts/MainLayout.astro'
import YMark from '../components/home/YMark.astro'
import HomeFlowDemo from '../components/home/HomeFlowDemo.astro'
import RecallPanelMock from '../components/home/RecallPanelMock.astro'
import InstallCta from '../components/InstallCta.astro'
import { en } from '../i18n/en'
import homeDeferredHref from '../styles/home-deferred.css?url'

const trustPointKeys = ['home.trust.1', 'home.trust.2', 'home.trust.3', 'home.trust.4'] as const
---

<MainLayout
  chrome="home"
  jsonLd
  title={en['home.meta.title']}
  description={en['home.meta.description']}
  i18nTitleKey="home.meta.title"
>
  <Fragment slot="head">
    <link
      rel="preload"
      href={homeDeferredHref}
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={homeDeferredHref} />
    </noscript>
  </Fragment>

  <!-- 1 · Hero：纯文案（无预约） -->
  <section id="hero" class="hero hero--copy">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__layout">
      <div class="hero__copy">
        <p class="hero__epithet" data-yiveno-i18n="home.hero.epithet">
          {en['home.hero.epithet']}
        </p>
        <h1 class="hero__title" data-yiveno-i18n="home.hero.title">
          {en['home.hero.title']}
        </h1>
        <p class="hero__sub" data-yiveno-i18n="home.hero.sub">
          {en['home.hero.sub']}
        </p>
      </div>
    </div>
  </section>

  <!-- 2 · Boundary：是 / 不是（短） -->
  <section class="home-sec home-sec--paper geo" aria-labelledby="geo-heading">
    <div class="home-wrap geo__layout">
      <div class="reveal">
        <h2
          id="geo-heading"
          data-yiveno-i18n-html="home.geo.title_html"
          set:html={en['home.geo.title_html']}
        />
        <p class="geo__lede" data-yiveno-i18n="home.geo.lede">
          {en['home.geo.lede']}
        </p>
      </div>
      <div class="geo__cols">
        <div class="reveal d1">
          <p class="geo__label" data-yiveno-i18n="home.geo.is_label">
            {en['home.geo.is_label']}
          </p>
          <ul class="geo__list">
            <li data-yiveno-i18n="home.geo.is_1">{en['home.geo.is_1']}</li>
            <li data-yiveno-i18n="home.geo.is_2">{en['home.geo.is_2']}</li>
          </ul>
        </div>
        <div class="reveal d2">
          <p class="geo__label" data-yiveno-i18n="home.geo.not_label">
            {en['home.geo.not_label']}
          </p>
          <ul class="geo__list geo__list--not">
            <li data-yiveno-i18n="home.geo.not_1">{en['home.geo.not_1']}</li>
            <li data-yiveno-i18n="home.geo.not_2">{en['home.geo.not_2']}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Mechanism：流程动画 Save → Forget → Recall -->
  <section class="home-sec home-sec--ink org" aria-labelledby="org-heading">
    <div class="home-wrap">
      <div class="reveal org__intro">
        <h2 id="org-heading" data-yiveno-i18n="home.org.title">
          {en['home.org.title']}
        </h2>
        <p class="org__lede" data-yiveno-i18n="home.org.lede">
          {en['home.org.lede']}
        </p>
      </div>
      <HomeFlowDemo />
    </div>
  </section>

  <!-- 4 · Capture -->
  <section class="home-sec home-sec--paper" aria-labelledby="capture-heading">
    <div class="home-wrap capture-layout">
      <div class="capture-copy reveal">
        <h2 id="capture-heading" data-yiveno-i18n="home.capture.title">
          {en['home.capture.title']}
        </h2>
        <p data-yiveno-i18n="home.capture.body">{en['home.capture.body']}</p>
        <p class="capture-copy__tag" data-yiveno-i18n="home.capture.tag">
          {en['home.capture.tag']}
        </p>
      </div>
      <div class="capture-visual reveal d1">
        <div class="capture-mock" aria-hidden="true">
          <div class="capture-mock__bar">
            <div class="capture-mock__dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="capture-mock__url"></div>
            <div class="capture-mock__ext">
              <YMark size={12} />
            </div>
          </div>
          <div class="capture-mock__page">
            <div class="capture-mock__line"></div>
            <div class="capture-mock__highlight">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="capture-mock__line capture-mock__line--dim"></div>
            <div class="capture-toast">
              <div class="capture-toast__head">
                <div class="capture-toast__icon">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path
                      d="M2 6L4.5 8.5L10 3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                <span data-yiveno-i18n="home.capture.toast_kicker">
                  {en['home.capture.toast_kicker']}
                </span>
              </div>
              <p class="capture-toast__quote" data-yiveno-i18n="home.capture.toast_quote">
                {en['home.capture.toast_quote']}
              </p>
              <p class="capture-toast__note">
                <span
                  class="capture-toast__note-label"
                  data-yiveno-i18n="home.capture.toast_note_label"
                >
                  {en['home.capture.toast_note_label']}
                </span>
                <span data-yiveno-i18n="home.capture.toast_note_body">
                  {en['home.capture.toast_note_body']}
                </span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Recall proof：Side Panel mock -->
  <section class="home-sec home-sec--dim examples" aria-labelledby="examples-heading">
    <div class="home-wrap examples__layout">
      <div class="examples__intro reveal">
        <h2
          id="examples-heading"
          data-yiveno-i18n-html="home.examples.title_html"
          set:html={en['home.examples.title_html']}
        />
        <p data-yiveno-i18n="home.examples.body">{en['home.examples.body']}</p>
      </div>
      <div class="examples__visual reveal d1">
        <RecallPanelMock />
      </div>
    </div>
  </section>

  <!-- 6 · Install（双店 CTA · ADR-020；未上架诚实 coming soon） -->
  <InstallCta />

  <!-- 7 · Trust -->
  <section id="trust" class="home-sec home-sec--ink trust-close" aria-labelledby="trust-heading">
    <div class="home-wrap trust-close__layout">
      <div class="trust-close__privacy reveal">
        <h2 id="trust-heading" data-yiveno-i18n="home.trust.title">
          {en['home.trust.title']}
        </h2>
        <ul class="trust-close__list">
          {trustPointKeys.map(key => (
            <li data-yiveno-i18n={key}>{en[key]}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { initHomePage } from '../scripts/home-page'

  initHomePage()
</script>
