---
import MainLayout from '../layouts/MainLayout.astro'
import YMark from '../components/home/YMark.astro'
import HomeFlowDemo from '../components/home/HomeFlowDemo.astro'
import RecallPanelMock from '../components/home/RecallPanelMock.astro'
import homeDeferredHref from '../styles/home-deferred.css?url'

const trustPoints = [
  'Your saved things stay yours — private by default, visible to no one else.',
  'You can delete what you saved, completely and at any time.',
  "We don't sell your collection or share it with third parties.",
  "We don't use your saved content to train public models."
]
---

<MainLayout
  chrome="home"
  jsonLd
  title="Yiveno — Find what you saved"
  description="Yiveno finds what you saved from what you remember. Closest fits — you pick. We're building the Chrome extension."
>
  <Fragment slot="head">
    <link
      rel="preload"
      href={homeDeferredHref}
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={homeDeferredHref} />
    </noscript>
  </Fragment>

  <!-- 1 · Hero：纯文案（无预约） -->
  <section id="hero" class="hero hero--copy">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__layout">
      <div class="hero__copy">
        <p class="hero__epithet">The one that finds things</p>
        <h1 class="hero__title">Find what you saved.</h1>
        <p class="hero__sub">
          You don't need the title. Say what you remember — closest fits, you pick. We're building
          the Chrome extension.
        </p>
      </div>
    </div>
  </section>

  <!-- 2 · Boundary：是 / 不是（短） -->
  <section class="home-sec home-sec--paper geo" aria-labelledby="geo-heading">
    <div class="home-wrap geo__layout">
      <div class="reveal">
        <h2 id="geo-heading">
          Yiveno is the thing <em class="home-kicker-em">that finds what you saved.</em>
        </h2>
        <p class="geo__lede">Closest fits on top — not one guaranteed answer. You decide.</p>
      </div>
      <div class="geo__cols">
        <div class="reveal d1">
          <p class="geo__label">What it is</p>
          <ul class="geo__list">
            <li>The finder for your own saved things</li>
            <li>Recall by saying what you remember</li>
          </ul>
        </div>
        <div class="reveal d2">
          <p class="geo__label">What it isn't</p>
          <ul class="geo__list geo__list--not">
            <li>Not a bookmark manager or notes app</li>
            <li>Not a chatbot that always picks one link</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · Mechanism：流程动画 Save → Forget → Recall -->
  <section class="home-sec home-sec--ink org" aria-labelledby="org-heading">
    <div class="home-wrap">
      <div class="reveal org__intro">
        <h2 id="org-heading">You don't have to organize everything.</h2>
        <p class="org__lede">
          Watch the loop: capture lightly, let time pass, recall in your own words.
        </p>
      </div>
      <HomeFlowDemo />
    </div>
  </section>

  <!-- 4 · Capture -->
  <section class="home-sec home-sec--paper" aria-labelledby="capture-heading">
    <div class="home-wrap capture-layout">
      <div class="capture-copy reveal">
        <h2 id="capture-heading">Save anything worth remembering.</h2>
        <p>
          A page. A passage. A thread. Add a personal note if you want — the kind of context only
          you would write. No folders. No tags. No titles required.
        </p>
        <p class="capture-copy__tag">Save first. Organize later — or never.</p>
      </div>
      <div class="capture-visual reveal d1">
        <div class="capture-mock" aria-hidden="true">
          <div class="capture-mock__bar">
            <div class="capture-mock__dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="capture-mock__url"></div>
            <div class="capture-mock__ext">
              <YMark size={12} />
            </div>
          </div>
          <div class="capture-mock__page">
            <div class="capture-mock__line"></div>
            <div class="capture-mock__highlight">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div class="capture-mock__line capture-mock__line--dim"></div>
            <div class="capture-toast">
              <div class="capture-toast__head">
                <div class="capture-toast__icon">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path
                      d="M2 6L4.5 8.5L10 3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                </div>
                Saved to Yiveno
              </div>
              <p class="capture-toast__quote">
                "The sea doesn't keep track of the things it's swallowed."
              </p>
              <p class="capture-toast__note">
                <span class="capture-toast__note-label">Note:</span>
                <span>remind me of this for the intro</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · Recall proof：Side Panel mock -->
  <section class="home-sec home-sec--dim examples" aria-labelledby="examples-heading">
    <div class="home-wrap examples__layout">
      <div class="examples__intro reveal">
        <h2 id="examples-heading">
          Remember the idea. <em class="home-kicker-em">That's enough.</em>
        </h2>
        <p>
          You recall the way you remember — in plain, imprecise, everyday language. Closest fits
          show up in the Side Panel.
        </p>
      </div>
      <div class="examples__visual reveal d1">
        <RecallPanelMock />
      </div>
    </div>
  </section>

  <!-- 6 · Trust -->
  <section id="trust" class="home-sec home-sec--ink trust-close" aria-labelledby="trust-heading">
    <div class="home-wrap trust-close__layout">
      <div class="trust-close__privacy reveal">
        <h2 id="trust-heading">Your memories are yours.</h2>
        <ul class="trust-close__list">
          {trustPoints.map(p => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { initHomePage } from '../scripts/home-page'

  initHomePage()
</script>
