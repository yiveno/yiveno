---
/**
 * 官网服务条款（与当前产品实现对齐；非律师意见书）。
 * 同 URL 双语：英文权威；中文便利译本（冲突以英文为准）。
 */
import MainLayout from '../layouts/MainLayout.astro'
import TermsProseEn from '../components/legal/TermsProseEn.astro'
import TermsProseZh from '../components/legal/TermsProseZh.astro'
import { en } from '../i18n/en'
import '../styles/pages.css'

const effectiveDate = '2026-10-18'
---

<MainLayout
  title={en['terms.meta.title']}
  description={en['terms.meta.description']}
  i18nTitleKey="terms.meta.title"
>
  <article class="page">
    <header>
      <h1 class="page__title" data-yiveno-i18n="terms.title">
        {en['terms.title']}
      </h1>
      <p class="page__meta">
        <span data-yiveno-legal-locale="en" lang="en">
          Effective date: {effectiveDate}
        </span>
        <span data-yiveno-legal-locale="zh_CN" lang="zh-CN" hidden>
          生效日期：{effectiveDate}
        </span>
      </p>
      <p
        class="page__hint"
        data-yiveno-legal-locale="zh_CN"
        lang="zh-CN"
        hidden
        data-yiveno-i18n="terms.translation_note"
      >
        {en['terms.translation_note']}
      </p>
    </header>

    <TermsProseEn />
    <TermsProseZh />
  </article>
</MainLayout>
