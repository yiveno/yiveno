---
import MainLayout from '../layouts/MainLayout.astro'
import AppNav from '../components/AppNav.astro'
import PricingPage from '../components/PricingPage.vue'
import { resolveVisitorCountry } from '../utils/request-country'
import '../styles/pages.css'

const countryCode = resolveVisitorCountry(Astro.request.headers)
---

<MainLayout
  title="Pricing · Yiveno"
  description="Yiveno Free vs Pro: same on-device recall quality; Pro adds cloud sync and a larger hosted clue-understanding quota."
>
  <AppNav slot="nav" />
  {
    countryCode ? (
      <PricingPage client:visible countryCode={countryCode} />
    ) : (
      <PricingPage client:visible />
    )
  }
</MainLayout>
