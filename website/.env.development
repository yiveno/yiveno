# ============================================
# 本地开发环境变量（不提交到版本控制）
# ============================================
#
# 📝 说明：
# - 此文件用于覆盖 .env 中的配置
# - 优先级：.env.local > .env
# - 用于本地开发时的特殊配置
#
# ============================================

# 官网 URL（开发环境）
VITE_WEBSITE_URL=http://localhost:3001

# API URL（开发环境 - 使用本地 Cloudflare Worker）
NUXT_PUBLIC_API_BASE_URL=https://localhost:8787

# Chrome 扩展 ID（用于官网与扩展通信）
# ⚠️ 本地开发时留空，让扩展通过 externally_connectable 自动接收消息
# 生产环境需要设置为固定的扩展 ID
NUXT_PUBLIC_EXTENSION_ID=
