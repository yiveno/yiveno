{
  "name": "yiveno-root",
  "private": true,
  "version": "1.0.0",
  "description": "Yiveno monorepo (Bun workspaces)",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "website",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.2.21",
  "resolutions": {
    "zod": "^3.25.76",
    "@types/node": "^24.3.0",
    "postcss": "^8.4.41",
    "stylelint": "^16.25.0",
    "typescript": "~5.8.3",
    "eslint": "^9.35.0",
    "vue": "^3.5.18",
    "@supabase/supabase-js": "^2.79.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "env:sync": "bun run env:sync:dev",
    "env:sync:dev": "bun ./scripts/dev-env.mjs sync --profile=development",
    "env:sync:prod": "bun ./scripts/dev-env.mjs sync --profile=production",
    "env:check": "bun run env:check:dev",
    "env:check:dev": "bun ./scripts/dev-env.mjs check --profile=development",
    "env:check:prod": "bun ./scripts/dev-env.mjs check --profile=production",
    "clean:deps": "rm -rf node_modules frontend/node_modules backend/node_modules website/node_modules packages/*/node_modules bun.lockb frontend/bun.lock backend/bun.lock 2>/dev/null || true && echo '🧹 清理完成'",
    "reinstall": "bun run clean:deps && bun install && echo '✅ 依赖已清理并重新安装'",
    "dev": "bun run watch",
    "dev:fe": "cd frontend && bun run dev",
    "dev:be": "cd backend && bun run dev",
    "dev:web": "cd website && bun run dev",
    "build": "bun run --filter @yiveno/design-tokens typecheck && bunx concurrently --kill-others-on-fail -n fe,be,web -c cyan,green,yellow \"bun run build:fe\" \"bun run build:be\" \"bun run build:web\"",
    "build:fe": "cd frontend && bun run build",
    "build:fe:prod": "cd frontend && bun run build:prod",
    "build:be": "cd backend && bun run build",
    "build:web": "cd website && bun run build:dev",
    "build:web:prod": "cd website && bun run build:prod",
    "build:prod": "bun run env:sync:prod && bun run env:check:prod && bun run --filter @yiveno/design-tokens typecheck && bunx concurrently --kill-others-on-fail -n fe,be,web -c cyan,green,yellow \"bun run build:fe:prod\" \"bun run build:be\" \"bun run build:web:prod\"",
    "build:color-presets": "bun scripts/build-material-color-presets.mjs",
    "watch": "bun run env:sync:dev && mprocs",
    "watch:stream": "bun run env:sync:dev && bunx concurrently --names fe,be,web --prefix-colors cyan,green,yellow \"bun run watch:fe\" \"bun run dev:be\" \"bun run dev:web\"",
    "watch:fe": "cd frontend && bun run build:watch",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "typecheck:fe": "cd frontend && bun run typecheck",
    "i18n:check": "cd frontend && bun run i18n:check",
    "typecheck:be": "cd backend && bun run typecheck",
    "typecheck:web": "cd website && bun run typecheck",
    "typecheck:ci": "bun run --filter './packages/*' --filter backend --filter yiveno-website typecheck",
    "typecheck:force": "bun run --workspaces --if-present typecheck:force",
    "typecheck:all": "bun run typecheck:force",
    "lint": "bun run format && bun run eslint && bun run stylelint",
    "lint:check": "bunx concurrently --kill-others-on-fail -n eslint,stylelint -c blue,magenta \"bun run eslint:check\" \"bun run stylelint:check\"",
    "format": "bunx prettier --write \"frontend/src/**/*.{ts,vue,css}\" \"frontend/vite/**/*.ts\" \"frontend/scripts/**/*.{js,cjs,mjs,ts}\" \"frontend/package.json\" \"backend/src/**/*.{ts,js}\" \"backend/package.json\" \"website/src/**/*.{ts,vue,astro,css,js}\" \"website/package.json\" \"packages/*/src/**/*.{ts,css}\" \"packages/*/package.json\" \"scripts/**/*.{mjs,js,ts}\" \"package.json\" \"knip.json\" \"mprocs.yaml\" \"tsconfig.base.json\" \"AGENTS.md\" \"README.md\" \"docs/**/*.md\" \".github/workflows/*.{yml,yaml}\" \".lintstagedrc.js\" \"eslint.config.js\"",
    "eslint": "bunx concurrently --kill-others-on-fail -n fe,be,web -c cyan,green,yellow \"cd frontend && bun run eslint\" \"cd backend && bun run eslint\" \"cd website && bun run eslint\"",
    "eslint:check": "bunx concurrently --kill-others-on-fail -n fe,be,web -c cyan,green,yellow \"cd frontend && bun run eslint:check\" \"cd backend && bun run eslint:check\" \"cd website && bun run eslint:check\"",
    "stylelint": "bunx concurrently --kill-others-on-fail -n fe,web -c cyan,yellow \"cd frontend && bun run stylelint\" \"cd website && bun run stylelint\"",
    "stylelint:check": "bunx concurrently --kill-others-on-fail -n fe,web -c cyan,yellow \"cd frontend && bun run stylelint:check\" \"cd website && bun run stylelint:check\"",
    "test": "cd frontend && bun run test",
    "test:fe": "cd frontend && bun run test",
    "test:be": "cd backend && bun run test",
    "e2e": "bun ./scripts/e2e-management.mjs --ext ${EXT_ID:-gdjcmpenmogdikhnnaebmddhmdgbfcgl}",
    "e2e:perf": "bun ./scripts/e2e-management.mjs --ext ${EXT_ID:-gdjcmpenmogdikhnnaebmddhmdgbfcgl} --perf",
    "e2e:all": "bun run e2e",
    "deploy:be": "cd backend && bun run deploy",
    "deploy:web": "cd website && bun run deploy",
    "db:start": "cd backend && bun run db:start",
    "db:stop": "cd backend && bun run db:stop",
    "db:reset": "cd backend && bun run db:reset",
    "db:new": "cd backend && bun run db:new",
    "db:logs": "cd backend && bun run logs",
    "clean": "cd frontend && bun run clean && cd ../backend && bun run clean",
    "knip": "bun scripts/knip-runner.mjs",
    "knip:report": "bun scripts/knip-runner.mjs -- --no-exit-code",
    "knip:fe": "bun scripts/knip-runner.mjs -- --workspace frontend",
    "knip:be": "bun scripts/knip-runner.mjs -- --workspace backend",
    "knip:web": "bun scripts/knip-runner.mjs -- --workspace website",
    "knip:fast": "bun scripts/knip-runner.mjs -- --include files,dependencies,devDependencies,duplicates,unlisted,binaries"
  },
  "yiveno": {
    "knip": "^6.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^3.2.0",
    "eslint-plugin-vue": "^10.4.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "postcss-html": "^1.7.0",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.43.0",
    "wrangler": "^4.117.0"
  }
}
