{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for AcuityBookmarks - Cloudflare Worker",
  "type": "module",
  "main": "cloudflare-worker.js",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --local-protocol https --https-cert-path ./localhost+2.pem --https-key-path ./localhost+2-key.pem",
    "build": "echo 'Backend: Cloudflare Worker 无需构建'",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:force": "tsc --noEmit --skipLibCheck",
    "lint": "bun run format && bun run eslint",
    "lint:check": "bun run eslint:check",
    "format": "bunx prettier --write \"**/*.{js,ts,json}\"",
    "eslint": "eslint . --no-cache --fix --max-warnings 0 --fix-type problem,suggestion,layout && echo '✅ ESLint: 所有问题已修复'",
    "eslint:check": "eslint . --no-cache --max-warnings 0 && echo '✅ ESLint: 检查通过'",
    "test": "bun test",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "logs": "wrangler tail",
    "clean": "rm -rf .wrangler node_modules/.cache"
  },
  "dependencies": {
    "@acuity-bookmarks/types": "workspace:*",
    "@supabase/supabase-js": "^2.79.0",
    "@trpc/server": "^10.45.2",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "zod": "^3.25.8"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240403.0",
    "@types/node": "^24.3.0",
    "supabase": "^1.187.3"
  },
  "runtime": "bun",
  "keywords": [
    "cloudflare-worker",
    "bookmark",
    "chrome-extension",
    "high-performance"
  ]
}
