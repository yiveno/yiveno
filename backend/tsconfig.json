{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* Cloudflare Workers environment */
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types", "@types/node", "@types/bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Path Aliases */
    "paths": {
      "@/*": ["./src/*"],
      "@yiveno/types": ["../packages/types/src/index.ts"]
    }
  },
  "include": ["src"]
}
