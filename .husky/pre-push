#!/usr/bin/env sh

echo "🚀 pre-push: 按变更做轻量验证（ESLint 由 pre-commit；全量门禁由 CI）..."

ERRORS=""

# 对比远端跟踪分支与待推送提交；无 upstream 时回退到最近一次提交
if git rev-parse --verify @{u} >/dev/null 2>&1; then
  CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR @{u}..HEAD)
else
  CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR HEAD~1 HEAD 2>/dev/null || git diff --name-only --diff-filter=ACMR HEAD)
fi

if [ -z "$CHANGED_FILES" ]; then
  echo "ℹ️  没有变更文件，跳过检查"
  exit 0
fi

echo "📋 变更文件:"
echo "$CHANGED_FILES" | head -20
echo ""

run_knip() {
  label="$1"
  shift
  echo "🔍 Knip: ${label}..."
  output=$(bun run knip -- "$@" 2>&1) || {
    echo "❌ Knip 失败: ${label}"
    ERRORS="${ERRORS}\n❌ Knip (${label}) 失败:\n${output}\n\n"
    return 1
  }
  echo "✅ Knip 通过: ${label}"
}

# extension / 共享包：构建（内含 vue-tsc -b）
EXTENSION_BUILD_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^extension/|^packages/(design-tokens|types)/|tsconfig|package\.json' || true)

if [ -n "$EXTENSION_BUILD_TRIGGER" ]; then
  echo "🏗️  extension 构建验证..."
  # 只跑一次：失败时复用同一份输出，避免静默失败后再全量重跑
  BUILD_OUTPUT=$(bun run build:extension 2>&1)
  BUILD_STATUS=$?
  if [ "$BUILD_STATUS" -eq 0 ]; then
    echo "✅ extension 构建成功"
  else
    echo "❌ extension 构建失败"
    ERRORS="${ERRORS}\n❌ extension 构建失败:\n${BUILD_OUTPUT}\n\n"
  fi

  if [ "$BUILD_STATUS" -eq 0 ]; then
    # build 内 vue-tsc -b 已覆盖 app + node + vitest（与 IDE solution 同图）
    # 本地 push 跑全量 test:run；CI 另有显式 test:must（防 vitest include 漂移）
    echo "🧪 extension test:run（范围含 recall-eval；CI 另显式 test:must）..."
    EXT_TEST_OUTPUT=$(cd extension && bun run test:run 2>&1)
    EXT_TEST_STATUS=$?
    if [ "$EXT_TEST_STATUS" -eq 0 ]; then
      echo "✅ extension test:run 通过"
    else
      echo "❌ extension test:run 失败"
      ERRORS="${ERRORS}\n❌ extension test:run 失败:\n${EXT_TEST_OUTPUT}\n\n"
    fi
  fi
else
  echo "⏭️  无 extension 构建相关变更，跳过构建验证"
fi

# worker：类型检查 + 单测（对标 extension 的 push 前保障）
WORKER_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^worker/' || true)

if [ -n "$WORKER_TRIGGER" ]; then
  echo "🧪 worker typecheck..."
  TC_OUTPUT=$(bun run typecheck:worker 2>&1)
  TC_STATUS=$?
  if [ "$TC_STATUS" -eq 0 ]; then
    echo "✅ worker typecheck 通过"
  else
    echo "❌ worker typecheck 失败"
    ERRORS="${ERRORS}\n❌ worker typecheck 失败:\n${TC_OUTPUT}\n\n"
  fi

  echo "🧪 worker test..."
  TEST_OUTPUT=$(cd worker && bun test 2>&1)
  TEST_STATUS=$?
  if [ "$TEST_STATUS" -eq 0 ]; then
    echo "✅ worker test 通过"
  else
    echo "❌ worker test 失败"
    ERRORS="${ERRORS}\n❌ worker test 失败:\n${TEST_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 worker 变更，跳过 typecheck / test"
fi

# website：astro check（CI typecheck:ci 已覆盖；push 前按变更补一层）
WEBSITE_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^website/' || true)

if [ -n "$WEBSITE_TRIGGER" ]; then
  echo "🧪 website typecheck..."
  WEB_TC_OUTPUT=$(bun run typecheck:web 2>&1)
  WEB_TC_STATUS=$?
  if [ "$WEB_TC_STATUS" -eq 0 ]; then
    echo "✅ website typecheck 通过"
  else
    echo "❌ website typecheck 失败"
    ERRORS="${ERRORS}\n❌ website typecheck 失败:\n${WEB_TC_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 website 变更，跳过 typecheck"
fi

# packages/*：独立 tsc（design-tokens/types 已可间接触发 FE build；mcp/probe 等仍需本层）
PACKAGES_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^packages/' || true)

if [ -n "$PACKAGES_TRIGGER" ]; then
  echo "🧪 packages typecheck..."
  PKG_TC_OUTPUT=$(bun run --filter './packages/*' typecheck 2>&1)
  PKG_TC_STATUS=$?
  if [ "$PKG_TC_STATUS" -eq 0 ]; then
    echo "✅ packages typecheck 通过"
  else
    echo "❌ packages typecheck 失败"
    ERRORS="${ERRORS}\n❌ packages typecheck 失败:\n${PKG_TC_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 packages 变更，跳过 typecheck"
fi

# 文档 / 开机层 / 漂移脚本：doc:check（CURRENT ↔ session-boot、message registry）
DOC_CHECK_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^docs/|^\.cursor/rules/|^scripts/' || true)

if [ -n "$DOC_CHECK_TRIGGER" ]; then
  echo "📄 doc:check（文档漂移 / session-boot 同步）..."
  DOC_OUTPUT=$(bun run doc:check 2>&1)
  DOC_STATUS=$?
  if [ "$DOC_STATUS" -eq 0 ]; then
    echo "✅ doc:check 通过"
  else
    echo "❌ doc:check 失败"
    ERRORS="${ERRORS}\n❌ doc:check 失败:\n${DOC_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 docs / rules / scripts 变更，跳过 doc:check"
fi

# 品牌母本变更：校验运行时 public/ 已同步
BRAND_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^docs/design/brand-assets/' || true)

if [ -n "$BRAND_TRIGGER" ]; then
  echo "🎨 sync:brand-assets --check（母本 → public）..."
  BRAND_OUTPUT=$(bun run sync:brand-assets --check 2>&1)
  BRAND_STATUS=$?
  if [ "$BRAND_STATUS" -eq 0 ]; then
    echo "✅ brand-assets 与 public 同步"
  else
    echo "❌ brand-assets 与 public 不同步"
    ERRORS="${ERRORS}\n❌ sync:brand-assets --check 失败:\n${BRAND_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 brand-assets 变更，跳过 sync:brand-assets --check"
fi

# 按变更目录跑分 workspace Knip（knip.json / 根依赖变更时跑全仓）
KNIP_FULL_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^knip\.json$|^package\.json$|^scripts/knip-runner\.mjs$' || true)
KNIP_EXTENSION_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^extension/' || true)
KNIP_WORKER_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^worker/' || true)
KNIP_WEB_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^website/' || true)
KNIP_PKG_TRIGGERS=$(echo "$CHANGED_FILES" | grep '^packages/' | cut -d/ -f1-2 | sort -u || true)

if [ -n "$KNIP_FULL_TRIGGER" ]; then
  run_knip "全仓" || true
else
  if [ -n "$KNIP_EXTENSION_TRIGGER" ]; then
    run_knip "extension" --workspace extension || true
  fi
  if [ -n "$KNIP_WORKER_TRIGGER" ]; then
    run_knip "worker" --workspace worker || true
  fi
  if [ -n "$KNIP_WEB_TRIGGER" ]; then
    run_knip "website" --workspace website || true
  fi
  if [ -n "$KNIP_PKG_TRIGGERS" ]; then
    for pkg in $KNIP_PKG_TRIGGERS; do
      run_knip "$pkg" --workspace "$pkg" || true
    done
  fi
  if [ -z "$KNIP_EXTENSION_TRIGGER$KNIP_WORKER_TRIGGER$KNIP_WEB_TRIGGER$KNIP_PKG_TRIGGERS" ]; then
    echo "⏭️  无 Knip 相关变更，跳过 Knip"
  fi
fi

if [ -n "$ERRORS" ]; then
  echo ""
  echo "🚨 =================================================="
  echo "🚨 推送前检查失败！发现以下问题："
  echo "🚨 =================================================="
  echo ""
  printf "%s" "$ERRORS"
  echo "💡 请修复以上问题后再推送。"
  echo ""
  echo "🛠️  可用的修复命令："
  echo "   bun run build:extension          # extension 构建（vue-tsc -b：app+node+vitest）"
  echo "   cd extension && bun run test:run  # extension 单测（范围含 recall-eval）"
  echo "   cd extension && bun run test:must # 显式 must（CI 另跑；防 include 漂移）"
  echo "   bun run typecheck:worker      # worker 类型检查"
  echo "   bun run typecheck:web     # website 类型检查（astro check）"
  echo "   bun run --filter './packages/*' typecheck  # packages 类型检查"
  echo "   cd worker && bun test    # worker 单测"
  echo "   bun run knip              # 全仓 Knip"
  echo "   bun run knip:extension           # 仅 extension Knip"
  echo "   bunx knip -D . --workspace worker           # 仅 worker Knip"
  echo "   bun run typecheck         # 类型检查（CI 也会跑）"
  echo "   bun run lint:check        # 代码质量检查（CI 也会跑）"
  echo "   bun run doc:check         # 文档漂移 / session-boot 同步（docs·rules·scripts 变更时）"
  echo "   bun run sync:ide-boot     # CURRENT → session-boot 当下块"
  echo "   bun run sync:brand-assets # 母本 → extension/website public"
  echo ""
  exit 1
fi

# Git LFS：推送前上传 LFS 对象（与 Husky 共存；勿 git lfs install --force）
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
fi

echo ""
echo "🎉 =================================================="
echo "🎉 推送前构建验证已通过，可以安全推送！"
echo "🎉 =================================================="
echo ""
