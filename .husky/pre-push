#!/usr/bin/env sh

echo "🚀 pre-push: 按变更做轻量验证（ESLint 由 pre-commit；全量门禁由 CI）..."

ERRORS=""

# 对比远端跟踪分支与待推送提交；无 upstream 时回退到最近一次提交
if git rev-parse --verify @{u} >/dev/null 2>&1; then
  CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR @{u}..HEAD)
else
  CHANGED_FILES=$(git diff --name-only --diff-filter=ACMR HEAD~1 HEAD 2>/dev/null || git diff --name-only --diff-filter=ACMR HEAD)
fi

if [ -z "$CHANGED_FILES" ]; then
  echo "ℹ️  没有变更文件，跳过检查"
  exit 0
fi

echo "📋 变更文件:"
echo "$CHANGED_FILES" | head -20
echo ""

run_knip() {
  label="$1"
  shift
  echo "🔍 Knip: ${label}..."
  output=$(bun run knip -- "$@" 2>&1) || {
    echo "❌ Knip 失败: ${label}"
    ERRORS="${ERRORS}\n❌ Knip (${label}) 失败:\n${output}\n\n"
    return 1
  }
  echo "✅ Knip 通过: ${label}"
}

# frontend / 共享包：构建（内含 vue-tsc -b）
FRONTEND_BUILD_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^frontend/|^packages/(design-tokens|types|auth-core)/|tsconfig|package\.json' || true)

if [ -n "$FRONTEND_BUILD_TRIGGER" ]; then
  echo "🏗️  frontend 构建验证..."
  # 只跑一次：失败时复用同一份输出，避免静默失败后再全量重跑
  BUILD_OUTPUT=$(bun run build:fe 2>&1)
  BUILD_STATUS=$?
  if [ "$BUILD_STATUS" -eq 0 ]; then
    echo "✅ frontend 构建成功"
  else
    echo "❌ frontend 构建失败"
    ERRORS="${ERRORS}\n❌ frontend 构建失败:\n${BUILD_OUTPUT}\n\n"
  fi

  if [ "$BUILD_STATUS" -eq 0 ]; then
    echo "🧪 frontend test:run（含 recall-eval must）..."
    FE_TEST_OUTPUT=$(cd frontend && bun run test:run 2>&1)
    FE_TEST_STATUS=$?
    if [ "$FE_TEST_STATUS" -eq 0 ]; then
      echo "✅ frontend test:run 通过"
    else
      echo "❌ frontend test:run 失败"
      ERRORS="${ERRORS}\n❌ frontend test:run 失败:\n${FE_TEST_OUTPUT}\n\n"
    fi
  fi
else
  echo "⏭️  无 frontend 构建相关变更，跳过构建验证"
fi

# backend：类型检查 + 单测（对标 FE 的 push 前保障）
BACKEND_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^backend/' || true)

if [ -n "$BACKEND_TRIGGER" ]; then
  echo "🧪 backend typecheck..."
  TC_OUTPUT=$(bun run typecheck:be 2>&1)
  TC_STATUS=$?
  if [ "$TC_STATUS" -eq 0 ]; then
    echo "✅ backend typecheck 通过"
  else
    echo "❌ backend typecheck 失败"
    ERRORS="${ERRORS}\n❌ backend typecheck 失败:\n${TC_OUTPUT}\n\n"
  fi

  echo "🧪 backend test..."
  TEST_OUTPUT=$(cd backend && bun test 2>&1)
  TEST_STATUS=$?
  if [ "$TEST_STATUS" -eq 0 ]; then
    echo "✅ backend test 通过"
  else
    echo "❌ backend test 失败"
    ERRORS="${ERRORS}\n❌ backend test 失败:\n${TEST_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 backend 变更，跳过 typecheck / test"
fi

# 文档 / 开机层 / 漂移脚本：doc:check（CURRENT ↔ session-boot、message registry）
DOC_CHECK_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^docs/|^\.cursor/rules/|^scripts/' || true)

if [ -n "$DOC_CHECK_TRIGGER" ]; then
  echo "📄 doc:check（文档漂移 / session-boot 同步）..."
  DOC_OUTPUT=$(bun run doc:check 2>&1)
  DOC_STATUS=$?
  if [ "$DOC_STATUS" -eq 0 ]; then
    echo "✅ doc:check 通过"
  else
    echo "❌ doc:check 失败"
    ERRORS="${ERRORS}\n❌ doc:check 失败:\n${DOC_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 docs / rules / scripts 变更，跳过 doc:check"
fi

# 品牌母本变更：校验运行时 public/ 已同步
BRAND_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^docs/design/brand-assets/' || true)

if [ -n "$BRAND_TRIGGER" ]; then
  echo "🎨 sync:brand-assets --check（母本 → public）..."
  BRAND_OUTPUT=$(bun run sync:brand-assets --check 2>&1)
  BRAND_STATUS=$?
  if [ "$BRAND_STATUS" -eq 0 ]; then
    echo "✅ brand-assets 与 public 同步"
  else
    echo "❌ brand-assets 与 public 不同步"
    ERRORS="${ERRORS}\n❌ sync:brand-assets --check 失败:\n${BRAND_OUTPUT}\n\n"
  fi
else
  echo "⏭️  无 brand-assets 变更，跳过 sync:brand-assets --check"
fi

# 按变更目录跑分 workspace Knip（knip.json / 根依赖变更时跑全仓）
KNIP_FULL_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^knip\.json$|^package\.json$|^scripts/knip-runner\.mjs$' || true)
KNIP_FE_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^frontend/' || true)
KNIP_BE_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^backend/' || true)
KNIP_WEB_TRIGGER=$(echo "$CHANGED_FILES" | grep -E '^website/' || true)
KNIP_PKG_TRIGGERS=$(echo "$CHANGED_FILES" | grep '^packages/' | cut -d/ -f1-2 | sort -u || true)

if [ -n "$KNIP_FULL_TRIGGER" ]; then
  run_knip "全仓" || true
else
  if [ -n "$KNIP_FE_TRIGGER" ]; then
    run_knip "frontend" --workspace frontend || true
  fi
  if [ -n "$KNIP_BE_TRIGGER" ]; then
    run_knip "backend" --workspace backend || true
  fi
  if [ -n "$KNIP_WEB_TRIGGER" ]; then
    run_knip "website" --workspace website || true
  fi
  if [ -n "$KNIP_PKG_TRIGGERS" ]; then
    for pkg in $KNIP_PKG_TRIGGERS; do
      run_knip "$pkg" --workspace "$pkg" || true
    done
  fi
  if [ -z "$KNIP_FE_TRIGGER$KNIP_BE_TRIGGER$KNIP_WEB_TRIGGER$KNIP_PKG_TRIGGERS" ]; then
    echo "⏭️  无 Knip 相关变更，跳过 Knip"
  fi
fi

if [ -n "$ERRORS" ]; then
  echo ""
  echo "🚨 =================================================="
  echo "🚨 推送前检查失败！发现以下问题："
  echo "🚨 =================================================="
  echo ""
  printf "%s" "$ERRORS"
  echo "💡 请修复以上问题后再推送。"
  echo ""
  echo "🛠️  可用的修复命令："
  echo "   bun run build:fe          # frontend 构建验证"
  echo "   cd frontend && bun run test:run  # frontend 单测（含 recall-eval must）"
  echo "   bun run typecheck:be      # backend 类型检查"
  echo "   cd backend && bun test    # backend 单测"
  echo "   bun run knip              # 全仓 Knip"
  echo "   bun run knip:fe           # 仅 frontend Knip"
  echo "   bun run knip:be           # 仅 backend Knip"
  echo "   bun run typecheck         # 类型检查（CI 也会跑）"
  echo "   bun run lint:check        # 代码质量检查（CI 也会跑）"
  echo "   bun run doc:check         # 文档漂移 / session-boot 同步（docs·rules·scripts 变更时）"
  echo "   bun run sync:ide-boot     # CURRENT → session-boot 当下块"
  echo "   bun run sync:brand-assets # 母本 → frontend/website public"
  echo ""
  exit 1
fi

# Git LFS：推送前上传 LFS 对象（与 Husky 共存；勿 git lfs install --force）
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@"
fi

echo ""
echo "🎉 =================================================="
echo "🎉 推送前构建验证已通过，可以安全推送！"
echo "🎉 =================================================="
echo ""
